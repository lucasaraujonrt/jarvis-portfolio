# Copie para .env apenas para execução real. Testes locais não usam este arquivo.
# Preencha no Mac, não commite o .env e carregue com source .env antes do gateway.

# Chave da xAI para a voz Zagan. Fica só no Mac. O iPhone não recebe esta chave.
XAI_API_KEY=
XAI_VOICE_ID=zagan

# Token obrigatório do gateway. Gere com: openssl rand -hex 24
# Copie o mesmo valor para Conexões no iPhone; o gateway não gera nem carrega o token sozinho.
JARVIS_GATEWAY_TOKEN=

# Opcional: caminho do executável quando o comando não está no PATH.
# Cada valor é só o caminho, sem flags.
# JARVIS_CODEX_COMMAND=/opt/homebrew/bin/codex
# JARVIS_CLAUDE_COMMAND=$HOME/.local/bin/claude
# JARVIS_GROK_COMMAND=$HOME/.grok/bin/grok
